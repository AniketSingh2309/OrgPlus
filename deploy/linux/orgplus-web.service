[Unit]
Description=Org+ web app (Next.js)
After=network-online.target orgplus-api.service
Wants=network-online.target

[Service]
User=orgplus
Group=orgplus
WorkingDirectory=/opt/orgplus/web
EnvironmentFile=/opt/orgplus/.env
Environment=NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
ExecStart=/opt/orgplus/web/node_modules/.bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/orgplus/web/.next
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
