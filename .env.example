# Copy to .env and fill in. Never commit .env or anything in ./secrets.

# --- Google (service account with domain-wide delegation) ---
# Optional fallback: you can instead upload the key on the /connect screen (stored encrypted).
# Defaults to secrets/orgpulse-sync.json in this folder (git-ignored).
# Override with an absolute path: GOOGLE_SERVICE_ACCOUNT_JSON=C:/path/to/key.json
GOOGLE_ADMIN_IMPERSONATE=orgpulse-admin@ourdomain.com
GOOGLE_CUSTOMER_ID=my_customer
# Classroom insights switch on automatically when the Classroom scopes are granted (false hides them)
ENABLE_CLASSROOM=true

# Master key. Encrypts each organisation's own data key, which in turn encrypts that
# organisation's service-account key and admin email. Generate: python -m orgpulse.crypto --new-key
# Keep it out of git and back it up: without it the stored credentials can't be decrypted.
CREDENTIAL_ENC_KEY=

# --- Sign-in: Org+ accounts (work email + password) ---
# People sign up at /signup (Workspace email + password), then scan a QR code with an
# authenticator app; every sign-in needs password + 6-digit code. The first person from a
# new organisation creates it.
# The web app's public address (used in password-reset links):
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Shared by web and API (the web proxy signs a 5-minute token with it). openssl rand -base64 48
NEXTAUTH_SECRET=
# Head-of-org accounts with full access (Workspace super admins always have it).
# Everyone else with reports gets the manager view (own OU + reports); others can't sign in.
ORG_ADMINS=head@ourdomain.com
# Wrong passwords before an account locks, and for how long.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Password-reset emails need SMTP (see SMTP_* below); sign-up doesn't. Development only:
# with no SMTP, write reset links to the API log instead. Never enable in production.
AUTH_EMAIL_LOG_LINKS=false
# Optional: organisations to create at deploy time without waiting for a sign-up.
ALLOWED_DOMAIN=

# Local development only: skip sign-in and act as DEV_USER_EMAIL. Never enable in production.
DEV_AUTH_BYPASS=false
DEV_USER_EMAIL=

# --- Database: one private database per organisation ---
# Passwordless Postgres on this machine. deploy/postgres/pg_hba.conf only accepts
# connections from localhost, and each role only into its own database.
CONTROL_DATABASE_URL=postgresql://orgplus_control@localhost:5432/orgplus_control
ORG_DATABASE_URL_TEMPLATE=postgresql://{role}@localhost:5432/{db}
# Provisioning role. Give it to the WORKER ONLY (set it in the worker's own environment,
# not in this shared file): the worker creates each new sign-up's database and migrates
# every organisation on start. The API warns if it can see it.
#   ADMIN_DATABASE_URL=postgresql://orgplus_admin@localhost:5432/postgres
#
# Organisations to create at deploy time, comma-separated (sign-ups create theirs
# automatically). Each gets its own database, role and encryption key.
ALLOWED_DOMAINS=
#
# Single-organisation mode (development/tests): remove CONTROL_DATABASE_URL and use
# DATABASE_URL=postgresql://orgpulse@localhost:5432/orgpulse

# --- Optional extras ---
# City-level IP database for the sign-in map. Free DB-IP City Lite (CC BY 4.0, no account):
# fetched by `python -m orgpulse.geoip_update` and refreshed monthly by the worker.
# Defaults to data/dbip-city-lite.mmdb in this folder.
# Override with an absolute path: GEOIP_DB=C:/path/to/city.mmdb
# Email (optional): password-reset links and the weekly digest
# (or set DIGEST_VIA_GMAIL=true and grant gmail.send to the service account for the digest).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=          # or SMTP_PASS
SMTP_FROM=
DIGEST_VIA_GMAIL=false

BACKFILL_DAYS=180
# Live activity: the worker checks every Google activity log this often (seconds), and
# re-reads days back every EVENTS_DEEP_MINUTES for events Google publishes late.
EVENTS_LIVE_SECONDS=60
EVENTS_DEEP_MINUTES=360
LOG_LEVEL=INFO
# Where the web app's server reaches the API
API_INTERNAL_URL=http://localhost:8000

# --- Real-time updates (Socket.IO) ---
# Where browsers open the live-update socket: the API's public address.
API_PUBLIC_URL=http://localhost:8000
# Websites allowed to open that socket: the Org+ web app's address(es), comma-separated.
WEB_ORIGINS=http://localhost:3000
